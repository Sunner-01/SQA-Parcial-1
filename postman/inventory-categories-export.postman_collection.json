{
  "info": {
    "_postman_id": "1c3f4e0a-7db0-4f55-8fbb-7c6f3f2c7f20",
    "name": "Inventory - Category Export",
    "description": "Prueba del endpoint que exporta las categorias a un archivo Excel.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Exportar categorias a Excel",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/categories/export/excel",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "categories",
            "export",
            "excel"
          ]
        },
        "description": "Descarga las categorias de la base de datos como result_category.xlsx."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('La respuesta es exitosa', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('La respuesta es un archivo Excel', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/octet-stream');",
              "});",
              "",
              "pm.test('La respuesta incluye el nombre del archivo', function () {",
              "    pm.expect(pm.response.headers.get('Content-Disposition')).to.include('result_category.xlsx');",
              "});"
            ]
          }
        }
      }
    ]
  }
}
