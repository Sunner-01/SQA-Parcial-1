              "value": "5"
            },
            {
              "key": "categoryId",
              "type": "text",
              "value": "{{categoryId}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Codigo de negocio', () => pm.expect(pm.response.json().metadata[0].code).to.eql('00'));",
              "const p=pm.response.json().product.products[0]; pm.test('Producto creado',()=>{pm.expect(p.id).to.be.a('number');pm.expect(p.name).to.eql('Leche SQA');pm.expect(p.category.id).to.eql(Number(pm.collectionVariables.get('categoryId')));}); pm.collectionVariables.set('productId',p.id);"
            ]
          }
        }
      ]
    },
