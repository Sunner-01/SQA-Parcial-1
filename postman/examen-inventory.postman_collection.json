{
  "info": {
    "name": "SQA examen - Categorias y Productos",
    "description": "Ejecutar completa en orden sobre una base local de pruebas. Crea datos propios y los elimina al final. Seleccionar fixtures/producto.png en las solicitudes multipart si Postman no resuelve la ruta. No ejecutar sobre produccion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "pictureBase64",
      "value": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+jRZkAAAAASUVORK5CYII="
    }
  ],
  "item": [
    {
      "name": "01 Crear categoria propia",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/categories",
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"SQA-{{$guid}}\",\"description\":\"Datos temporales del examen\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset('categoryId'); pm.collectionVariables.unset('productId');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Codigo de negocio', () => pm.expect(pm.response.json().metadata[0].code).to.eql('00'));",
              "const c=pm.response.json().categoryResponse.category[0]; pm.test('Categoria creada',()=>{pm.expect(c.id).to.be.a('number'); pm.expect(c.name).to.match(/^SQA-/);}); pm.collectionVariables.set('categoryId',c.id); pm.collectionVariables.set('categoryName',c.name);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Listar categorias",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/categories"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Codigo de negocio', () => pm.expect(pm.response.json().metadata[0].code).to.eql('00'));",
              "pm.test('Contiene categoria creada',()=>pm.expect(pm.response.json().categoryResponse.category.map(c=>String(c.id))).to.include(String(pm.collectionVariables.get('categoryId'))));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Consultar categoria",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/categories/{{categoryId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Codigo de negocio', () => pm.expect(pm.response.json().metadata[0].code).to.eql('00'));",
              "pm.test('Nombre persistido',()=>pm.expect(pm.response.json().categoryResponse.category[0].name).to.eql(pm.collectionVariables.get('categoryName')));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Actualizar categoria",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/categories/{{categoryId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"SQA-actualizada\",\"description\":\"Descripcion actualizada\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Codigo de negocio', () => pm.expect(pm.response.json().metadata[0].code).to.eql('00'));",
              "pm.test('Categoria actualizada',()=>pm.expect(pm.response.json().categoryResponse.category[0].description).to.eql('Descripcion actualizada'));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Verificar actualizacion categoria",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/categories/{{categoryId}}"
